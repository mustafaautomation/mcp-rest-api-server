# Upstream REST API. Leave unset to boot the bundled Harborline sandbox.
API_BASE_URL=https://api.example.com

# Sent as Authorization: Bearer, or as x-api-key when API_AUTH_STYLE=api-key.
# Required when API_BASE_URL is set. Never commit a real key.
API_KEY=replace-me

# bearer | api-key | both
API_AUTH_STYLE=bearer

# Header used when API_AUTH_STYLE is api-key or both.
API_KEY_HEADER=x-api-key

# true keeps the server read-only (write tools are not registered).
MCP_READ_ONLY=true

API_TIMEOUT_MS=10000
API_MAX_RETRIES=3
API_RETRY_BASE_MS=200
API_RETRY_MAX_MS=8000
API_RATE_LIMIT_RPS=10
API_RATE_LIMIT_BURST=20

# Streamable HTTP transport. Bind localhost unless you set a token.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
# Required before you expose the HTTP port beyond your machine.
MCP_HTTP_TOKEN=

# Standalone `mcp-rest-api-server mock` bind address.
MOCK_API_HOST=127.0.0.1
MOCK_API_PORT=8788

# debug | info | warn | error | silent
LOG_LEVEL=info
